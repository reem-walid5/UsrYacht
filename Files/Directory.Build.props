		<Compile Include="$(PkgPath)/UsrYacht/Schemas/UsrYachtCountry/UsrYachtCountry.cs" Condition="Exists('$(PkgPath)/UsrYacht/Schemas/UsrYachtCountry/UsrYachtCountry.cs')" />
